<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>liagosoft.SuperReader</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>azreader</string>
			</array>
		</dict>
	</array>
	<!-- Caprasimo-Regular.ttf and the Figtree family still need to be added to
	     Resources/Fonts/ and registered here once the font assets are sourced
	     (see docs/revamp-ios/README.md · "Assets"). -->
	<key>UIAppFonts</key>
	<array>
		<string>Lora-Regular.ttf</string>
	</array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>SuperReader needs access to your local network to communicate with the development server.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
